{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissoes da janela principal: abrir links, controlar o sidecar do daemon e instalar a versao nova do app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "opener:default",
    "dialog:allow-open",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/agent-hub-daemon",
          "sidecar": true,
          "args": ["start"]
        }
      ]
    }
  ]
}
